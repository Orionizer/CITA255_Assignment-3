<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="DemoCode_10_1.Checkout"
             >
    <ScrollView>
        <VerticalStackLayout>
            <Grid RowDefinitions="Auto, Auto, *, Auto, Auto, Auto, Auto, Auto" RowSpacing="40">
                <Label Grid.Row="0" Text="Cart and Checkout" FontSize="20" Padding="5"/>
                <Label Grid.Row="1" Text=""/>
                <Label Grid.Row="6" Text="Total: $0" FontSize="15" HorizontalTextAlignment="Start"/>
                <Button Grid.Row="7" Text="Checkout"  Clicked="TotalClicked"/>
            </Grid>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>